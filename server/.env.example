# The API/local learning work without MongoDB; remote saves return 503 until configured.
# Use a NEW giglink-prep database, never the original GigLink database.
# Copy your own private Atlas URI here locally. Never use a VITE_ variable for it.
MONGODB_URI=
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# On Render: NODE_ENV=production and CLIENT_ORIGIN is your exact HTTPS Vercel
# origin, with no trailing slash. Render supplies PORT; do not set it there.
NODE_ENV=development
