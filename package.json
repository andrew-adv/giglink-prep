{
  "name": "giglink-prep",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["client", "server"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n client,api -c cyan,green \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "preview": "npm run preview --workspace=client",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspace=client && npm run test --workspace=server"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
